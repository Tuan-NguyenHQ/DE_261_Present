# ============================================================
#  TravelHub Pipeline Runner — Dockerfile
#  Base: apache/spark:3.5.3 (official Apache image)
#  Contains: Python, PySpark, dbt-core, dbt-clickhouse
# ============================================================
FROM apache/spark:3.5.3

USER root

# Install system deps
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl git python3-pip python3-dev build-essential \
    && rm -rf /var/lib/apt/lists/*

# Install Python packages
COPY requirements.txt /tmp/requirements.txt
RUN pip3 install --no-cache-dir -r /tmp/requirements.txt

# Download required JARs for Spark
RUN mkdir -p /opt/spark/jars-extra && \
    curl -sL -o /opt/spark/jars-extra/iceberg-spark-runtime-3.5_2.12-1.5.0.jar \
      https://repo1.maven.org/maven2/org/apache/iceberg/iceberg-spark-runtime-3.5_2.12/1.5.0/iceberg-spark-runtime-3.5_2.12-1.5.0.jar && \
    curl -sL -o /opt/spark/jars-extra/spark-xml_2.12-0.18.0.jar \
      https://repo1.maven.org/maven2/com/databricks/spark-xml_2.12/0.18.0/spark-xml_2.12-0.18.0.jar && \
    curl -sL -o /opt/spark/jars-extra/clickhouse-jdbc-0.6.0-all.jar \
      https://repo1.maven.org/maven2/com/clickhouse/clickhouse-jdbc/0.6.0/clickhouse-jdbc-0.6.0-all.jar && \
    curl -sL -o /opt/spark/jars-extra/hadoop-aws-3.3.4.jar \
      https://repo1.maven.org/maven2/org/apache/hadoop/hadoop-aws/3.3.4/hadoop-aws-3.3.4.jar && \
    curl -sL -o /opt/spark/jars-extra/aws-java-sdk-bundle-1.12.262.jar \
      https://repo1.maven.org/maven2/com/amazonaws/aws-java-sdk-bundle/1.12.262/aws-java-sdk-bundle-1.12.262.jar

WORKDIR /opt

# Copy dbt project
COPY dbt_project /opt/dbt
COPY spark_jobs /opt/spark-jobs
COPY scripts /opt/scripts

RUN chmod +x /opt/scripts/*.py 2>/dev/null || true
